# Corporative's internal Artifactory mirror for npm — same pattern as the
# Python `--index-url` used across the ecosystem's `uv` commands (see the
# ecosystem's Corporative-specific setup notes). Needed on the corporate
# network/VPN where the public npm registry returns 407 Proxy
# Authentication Required.
registry=https://npm.ci.artifacts.walmart.com/artifactory/api/npm/external-npm
