#!/usr/bin/env bash
# pre-commit: word-check
# Skip in emergencies with: git commit --no-verify
set -euo pipefail

echo "==> [pre-commit] word-check (banned terms across the pf ecosystem)"
WORD_CHECK="../../scripts/replace-words.py"
if [ -f "$WORD_CHECK" ]; then
  if ! python3 "$WORD_CHECK"; then
    echo ""
    echo "Pending word replacements found across the ecosystem (see above)."
    echo "Run 'python3 $WORD_CHECK --apply' to fix, then re-stage and commit."
    exit 1
  fi
else
  echo "Skipping word-check: $WORD_CHECK not found (standalone checkout without the pf-base root?)"
fi

echo ""
echo "pre-commit checks passed"
